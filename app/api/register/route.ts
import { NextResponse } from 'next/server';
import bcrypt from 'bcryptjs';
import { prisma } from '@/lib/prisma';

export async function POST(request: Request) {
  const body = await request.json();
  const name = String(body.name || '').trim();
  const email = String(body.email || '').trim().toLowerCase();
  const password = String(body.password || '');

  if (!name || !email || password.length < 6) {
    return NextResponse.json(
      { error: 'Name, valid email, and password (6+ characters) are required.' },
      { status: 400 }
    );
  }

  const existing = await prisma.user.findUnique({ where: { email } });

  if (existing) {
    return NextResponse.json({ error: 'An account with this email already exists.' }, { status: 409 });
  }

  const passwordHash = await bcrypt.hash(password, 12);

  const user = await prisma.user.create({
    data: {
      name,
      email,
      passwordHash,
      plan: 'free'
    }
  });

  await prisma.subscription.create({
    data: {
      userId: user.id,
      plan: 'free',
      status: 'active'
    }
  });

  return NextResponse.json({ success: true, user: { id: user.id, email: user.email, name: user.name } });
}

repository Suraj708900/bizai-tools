import { getServerSession } from 'next-auth';
import { NextResponse } from 'next/server';
import { authOptions } from '@/lib/auth';
import { prisma } from '@/lib/prisma';
import { checkGenerationAllowed } from '@/lib/usage';
import { buildToolPrompt } from '@/lib/ai';

export async function POST(request: Request) {
  const session = await getServerSession(authOptions);

  if (!session?.user?.id) {
    return NextResponse.json({ error: 'You must be signed in to generate content.' }, { status: 401 });
  }

  const body = await request.json();
  const tool = String(body.tool || 'AI Email Writer');
  const prompt = String(body.prompt || '').trim();

  if (!prompt) {
    return NextResponse.json({ error: 'Missing prompt input.' }, { status: 400 });
  }

  const user = await prisma.user.findUnique({
    where: { id: session.user.id },
    include: { subscriptions: true }
  });

  if (!user) {
    return NextResponse.json({ error: 'User not found.' }, { status: 404 });
  }

  const currentPlan = user.subscriptions.find((sub) => sub.status === 'active')?.plan || user.plan || 'free';
  const usageCheck = await checkGenerationAllowed(user.id, currentPlan);

  if (!usageCheck.allowed) {
    return NextResponse.json(
      {
        error: usageCheck.reason,
        usage: usageCheck.usage,
        plan: currentPlan
      },
      { status: 429 }
    );
  }

  const apiKey = process.env.OPENAI_API_KEY;

  if (!apiKey) {
    return NextResponse.json(
      {
        error: 'AI API is not configured. Add OPENAI_API_KEY to your environment variables to enable live generation.'
      },
      { status: 503 }
    );
  }

  try {
    const response = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${apiKey}`
      },
      body: JSON.stringify({
        model: process.env.OPENAI_MODEL || 'gpt-4o-mini',
        messages: [
          {
            role: 'system',
            content: 'You are a helpful business writing assistant for BizAI Tools. Create professional, useful, and concise business content.'
          },
          {
            role: 'user',
            content: buildToolPrompt(tool, prompt)
          }
        ],
        temperature: 0.7
      })
    });

    if (!response.ok) {
      const errText = await response.text();
      return NextResponse.json({ error: `AI request failed: ${errText}` }, { status: response.status });
    }

    const data = await response.json();
    const output = data.choices?.[0]?.message?.content || 'No content returned by the AI API.';

    await prisma.generation.create({
      data: {
        userId: user.id,
        tool,
        prompt,
        result: output
      }
    });

    await prisma.project.upsert({
      where: {
        id: `${user.id}-${tool}-project`
      },
      update: {
        updatedAt: new Date(),
        description: prompt.slice(0, 200)
      },
      create: {
        id: `${user.id}-${tool}-project`,
        userId: user.id,
        name: tool,
        description: prompt.slice(0, 200),
        status: 'Generated'
      }
    });

    return NextResponse.json({ output, source: 'openai' });
  } catch (error) {
    return NextResponse.json(
      {
        error: error instanceof Error ? error.message : 'Unexpected AI generation error.'
      },
      { status: 500 }
    );
  }
}
